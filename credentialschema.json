{
  "name": "Todistus Kelan eläkkeestä",
  "description": "Todisteessa mainittu henkilö saa Kelan maksamaa eläkettä",
  "localization": [
    {
      "locale": "en",
      "name": "Kela Pension Credential",
      "description": "The subject receives pension from Kela"
    },
    {
      "locale": "sv-SE",
      "name": "Intyg om pension från Kela",
      "description": "Mottagaren får pension från Kela"
    }
  ],
  "issuer": "did:web",
  "type": "https://alennusperuste.todiste.fi/credentials/v2/PensionCredential",
  "background": {
    "color": "#0a00be",
    "url": "https://pensiondemo.findy.fi/kela.png"
   },
   "text": {
    "color": "#FFFFFF"
   },

  "revocable": false,
  "validFrom": "2026-08-25",
  "validUntil": {
    "start": "validFrom",
    "future": {
      "months": 12
    }
  },
  "attributes": {
    "Pension.effectual": {
      "type": "boolean",
      "name": "Eläke",
      "description": "Eläkepäätös on voimassa.",
      "required": false,
      "alwaysDisclosed": false,
      "localization": [
        {
          "locale": "en",
          "name": "Pension",
          "description": "The pension decision is effectual."
        },
        {
          "locale": "sv-SE",
          "name": "Pension",
          "description": "Pensionsbeslutet är giltigt."
        }
      ]
     },
    "Person.personal_administrative_number": {
      "type": "string",
      "name": "Henkilötunnus",
      "description": "Eläkkeensaajan yksilöivä henkilötunnus.",
      "required": false,
      "alwaysDisclosed": false,
      "localization": [
        {
          "locale": "en",
          "name": "Person ID",
          "description": "The unique personal identifier of the pension recipient."
        },
        {
          "locale": "sv-SE",
          "name": "Personbeteckning",
          "description": "Pensionsmottagarens unika personbeteckning."
        }
      ]
    }
  }
}
