{
  "name": "Todistus Kelan eläkkeestä",
  "description": "Todisteessa mainittu henkilö saa Kelan maksamaa eläkettä",
  "localization": [
    {
      "locale": "en",
      "name": "Kela Pension Credential",
      "description": "The subject receives pension from Kela"
    },
    {
      "locale": "sv-SE",
      "name": "Intyg om pension från Kela",
      "description": "Mottagaren får pension från Kela"
    }
  ],
  "issuer": {
    "signer": "certificate",
    "keyType": "P-256"
  },
  "type": "https://alennusperuste.todiste.fi/credentials/v3/PensionCredential",
  "background": {
    "color": "#003680",
    "url": "https://pensiondemo.findy.fi/kela.png"
   },
   "text": {
    "color": "#FFFFFF"
   },

  "revocable": false,
  "validUntil": {
    "start": "issuance",
    "future": {
      "months": 12
    }
  },
  "attributes": {
    "Hetu": {
      "type": "string",
      "name": "Eläkkeensaajan henkilötunnus",
      "required": true,
      "alwaysDisclosed": false,
      "localization": [
        {
          "locale": "en",
          "name": "Pensioner's personal identity code"
        },
        {
          "locale": "sv-SE",
          "name": "Pensionärens personbeteckning"
        }
      ]
    },
    "Voimassa": {
      "type": "boolean",
      "name": "Eläkepäätöksen voimassaolo",
      "required": false,
      "alwaysDisclosed": false,
      "localization": [
        {
          "locale": "en",
          "name": "Validity of the pension decision"
        },
        {
          "locale": "sv-SE",
          "name": "Pensionsbeslutets giltighet"
        }
      ]
    },
    "Muodostettu": {
      "type": "string",
      "name": "Todiste muodostettu",
      "description": "Päivä, jolloin Kela myönsi digitaalisen todisteen.",
      "required": true,
      "alwaysDisclosed": false,
      "localization": [
        {
          "locale": "en",
          "name": "Credential created"
        },
        {
          "locale": "sv-SE",
          "name": "Intyget skapat"
        }
      ]
    }
  }
}
